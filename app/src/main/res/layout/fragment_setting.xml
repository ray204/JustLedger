<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:fitsSystemWindows="true" android:background="@color/ledger_background">
<com.google.android.material.appbar.MaterialToolbar android:id="@+id/topAppBar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:title="设置" />
<androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="12dp" android:paddingBottom="24dp"><net.ankio.auto.ui.components.SettingItemView android:id="@+id/setting_capture" android:layout_width="match_parent" android:layout_height="wrap_content" app:settingTitle="自动记账" app:settingDesc="权限与后台运行" app:settingIcon="@drawable/ic_notifications" />
<net.ankio.auto.ui.components.SettingItemView android:id="@+id/setting_recording" android:layout_width="match_parent" android:layout_height="wrap_content" app:settingTitle="记账偏好" app:settingDesc="入账方式与币种" app:settingIcon="@drawable/ic_receipt_long" />
<net.ankio.auto.ui.components.SettingItemView android:id="@+id/setting_interaction" android:layout_width="match_parent" android:layout_height="wrap_content" app:settingTitle="屏幕识别" app:settingDesc="识别方式与提醒" app:settingIcon="@drawable/ic_ocr" />
<net.ankio.auto.ui.components.SettingItemView android:id="@+id/setting_books" android:layout_width="match_parent" android:layout_height="wrap_content" app:settingTitle="分类与账户" app:settingDesc="整理账本内容" app:settingIcon="@drawable/ic_book" />
<net.ankio.auto.ui.components.SettingItemView android:id="@+id/setting_data_management" android:layout_width="match_parent" android:layout_height="wrap_content" app:settingTitle="备份与恢复" app:settingDesc="保留一份账单副本" app:settingIcon="@drawable/setting2_icon_backup" />
<net.ankio.auto.ui.components.SettingItemView android:id="@+id/setting_system" android:layout_width="match_parent" android:layout_height="wrap_content" app:settingTitle="外观" app:settingDesc="深色模式与语言" app:settingIcon="@drawable/ic_palette" />
<net.ankio.auto.ui.components.SettingItemView android:id="@+id/setting_rules" android:layout_width="match_parent" android:layout_height="wrap_content" app:settingTitle="识别规则" app:settingDesc="管理渠道识别规则" app:settingIcon="@drawable/home_rule" />
<net.ankio.auto.ui.components.SettingItemView android:id="@+id/setting_about" android:layout_width="match_parent" android:layout_height="wrap_content" app:settingTitle="关于 JustLedger" app:settingDesc="版本与开源致谢" app:settingIcon="@drawable/ic_info" /></LinearLayout></androidx.core.widget.NestedScrollView></LinearLayout>