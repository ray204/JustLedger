<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/HomeCard" app:cardBackgroundColor="@color/ledger_hero" app:cardCornerRadius="28dp" app:strokeWidth="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/monthLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/ledger_hero_muted" android:textSize="14sp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/privacyToggle" style="@style/Widget.Material3.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="48dp" android:padding="12dp" android:contentDescription="@string/ledger_privacy" app:icon="@drawable/ledger_eye" app:iconTint="@color/ledger_on_hero" app:iconPadding="0dp"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/month_expense" android:textColor="@color/ledger_hero_muted" android:textSize="14sp"/>
        <TextView android:id="@+id/tvExpenseAmount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="—" android:fontFamily="sans-serif-medium" android:textColor="@color/ledger_on_hero" android:textSize="38sp" android:maxLines="1" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="20sp" app:autoSizeMaxTextSize="38sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:baselineAligned="false">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingEnd="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/month_income" android:textColor="@color/ledger_hero_muted" android:textSize="13sp"/>
                <TextView android:id="@+id/tvIncomeAmount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="—" android:textColor="@color/ledger_on_hero" android:textSize="20sp" android:maxLines="1" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="12sp" app:autoSizeMaxTextSize="20sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ledger_balance" android:textColor="@color/ledger_hero_muted" android:textSize="13sp"/>
                <TextView android:id="@+id/tvBalanceAmount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="—" android:textColor="@color/ledger_on_hero" android:textSize="20sp" android:maxLines="1" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="12sp" app:autoSizeMaxTextSize="20sp"/>
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/loadStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/ledger_amount_unavailable" android:textColor="@color/ledger_hero_muted" android:textSize="12sp" android:visibility="gone" android:accessibilityLiveRegion="polite"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnBills" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="18dp" android:text="@string/ledger_view_bills" android:textColor="@color/ledger_on_hero" app:icon="@drawable/ic_receipt_long" app:iconTint="@color/ledger_on_hero"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSync" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/btn_bill_sync" android:textColor="@color/ledger_on_hero" app:icon="@drawable/ic_sync" app:iconTint="@color/ledger_on_hero" android:visibility="gone"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
