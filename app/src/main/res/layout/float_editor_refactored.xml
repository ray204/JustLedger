<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <include android:id="@+id/book_header" layout="@layout/component_book_header"
        android:layout_width="match_parent" android:layout_height="48dp" android:layout_alignParentTop="true" />
    <ScrollView android:id="@+id/scrollView" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_below="@id/book_header"
        android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingBottom="12dp">
            <include android:id="@+id/amount_display" layout="@layout/component_amount_display"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <LinearLayout android:id="@+id/reviewCard" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="12dp"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="12dp"
                android:paddingVertical="8dp" android:background="@drawable/ledger_review_background" android:visibility="gone">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:paddingEnd="4dp">
                    <TextView android:id="@+id/reviewReason" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textSize="13sp" android:fontFamily="sans-serif-medium"
                        android:textColor="@color/ledger_ink" android:accessibilityLiveRegion="polite" />
                    <TextView android:id="@+id/reviewHint" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:textSize="11sp" android:textColor="@color/ledger_muted" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/enrichExisting"
                    style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                    android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="8dp"
                    android:text="补充原账单" android:textSize="12sp" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:id="@+id/possibleBills" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginBottom="12dp" android:visibility="gone" />
            <include android:id="@+id/transaction_type_selector" layout="@layout/component_transaction_type_selector"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <include android:id="@+id/basic_info" layout="@layout/component_basic_info"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <include android:id="@+id/payment_info" layout="@layout/component_payment_info"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <com.google.android.material.button.MaterialButton android:id="@+id/receiptDetails"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent"
                android:layout_height="48dp" android:gravity="start|center_vertical" android:paddingHorizontal="8dp"
                android:text="更多订单信息  ›" android:textSize="12sp" android:visibility="gone" />
            <include android:id="@+id/rule_info" layout="@layout/component_rule_info"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
            <include android:id="@+id/action_buttons" layout="@layout/component_action_buttons"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
