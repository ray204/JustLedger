<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <net.ankio.auto.ui.components.IconView android:id="@+id/merchant" android:layout_width="match_parent"
        android:layout_height="48dp" android:paddingHorizontal="8dp" app:iconSrc="@drawable/ic_receipt_long"
        app:textSize="13sp" app:iconTintEnabled="true" app:textColor="?attr/colorOnSurface" />
    <net.ankio.auto.ui.components.IconView android:id="@+id/product" android:layout_width="match_parent"
        android:layout_height="48dp" android:paddingHorizontal="8dp" app:iconSrc="@drawable/ledger_category_shopping"
        app:textSize="13sp" app:iconTintEnabled="true" app:textColor="?attr/colorOnSurface" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <net.ankio.auto.ui.components.IconView android:id="@+id/category" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1" android:paddingHorizontal="8dp"
            app:iconSrc="@drawable/default_cate" app:textSize="13sp" app:iconTintEnabled="true" app:textColor="?attr/colorOnSurface" />
        <net.ankio.auto.ui.components.IconView android:id="@+id/money_type" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1" android:paddingHorizontal="8dp"
            app:iconSrc="@drawable/float_money" app:textSize="13sp" app:iconTintEnabled="false" app:textColor="?attr/colorOnSurface" />
    </LinearLayout>
    <net.ankio.auto.ui.components.IconView android:id="@+id/time" android:layout_width="match_parent"
        android:layout_height="48dp" android:paddingHorizontal="8dp" app:iconSrc="@drawable/float_time"
        app:textSize="13sp" app:iconTintEnabled="true" app:textColor="?attr/colorOnSurface" />
    <LinearLayout android:id="@+id/occasional_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="8dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="偶发支出" android:textSize="13sp" android:textColor="?attr/colorOnSurface" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="不计日常开销，仍计入总支出" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/occasional_switch" android:layout_width="wrap_content" android:layout_height="48dp" android:contentDescription="偶发支出，不计日常开销，仍计入总支出" />
    </LinearLayout>
    <com.google.android.flexbox.FlexboxLayout android:id="@+id/tag_labels" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="8dp" android:visibility="gone"
        app:alignItems="center" app:flexWrap="wrap" app:dividerDrawableHorizontal="@drawable/flex_item_gap"
        app:dividerDrawableVertical="@drawable/flex_item_gap" app:showDividerHorizontal="middle" app:showDividerVertical="middle" />
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/text_field"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:hint="备注（选填）" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/remark"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:textSize="13sp" android:maxLines="2" android:minLines="1" android:paddingVertical="12dp"
            android:inputType="textMultiLine|textCapSentences" android:scrollHorizontally="false" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
